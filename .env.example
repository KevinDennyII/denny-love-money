# Database
# Local Docker: docker compose up -d && npm run db:push:docker && npm run db:seed-users:docker
# DATABASE_URL=postgresql://postgres:postgres@localhost:5435/denny_love_money
#
# On Replit this is injected automatically
DATABASE_URL=

# Privacy.com API (Replit Secrets / local .env — never commit the real key)
PRIVACY_API_KEY=

# Background sync of recent approved charges (minutes). Set 0 to disable.
PRIVACY_AUTO_SYNC_MINUTES=15
PRIVACY_AUTO_SYNC_DAYS=7

# Webhook URL (Privacy.com settings): https://YOUR_REPLIT_URL/api/privacy/webhook
# Only for local webhook testing — never enable in production:
# PRIVACY_WEBHOOK_SKIP_HMAC=true

# BankSync.io (USAA balances — Replit Secrets / local .env — never commit the real key)
BANKSYNC_API_KEY=
# Background balance sync (minutes). Set 0 to disable.
BANKSYNC_AUTO_SYNC_MINUTES=60
# Emergency savings account last4 + minimum goal
BANKSYNC_EMERGENCY_LAST4=1559
BANKSYNC_EMERGENCY_GOAL=1500
# Jamie's personal Chime last4 (optional — keeps it separate from family Chime Checking)
# BANKSYNC_JAMIE_CHIME_LAST4=
